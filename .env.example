# PATAPOTEA environment (all optional)
PORT=3001
NODE_ENV=production

# SQLite file location (defaults to ./data/patapotea.db)
DB_PATH=./data/patapotea.db

# Replace these before exposing the demo to anyone else.
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_PLAYER_PASSWORD=change-me-Player1

# Set to 1 only when running behind a trusted reverse proxy (nginx, Caddy, etc.)
TRUST_PROXY=0
