{
  "name": "patapotea",
  "version": "1.0.0",
  "private": true,
  "description": "PATAPOTEA - Aviator-style crash game demo with virtual credits only",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "concurrently -n server,client -c red,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
